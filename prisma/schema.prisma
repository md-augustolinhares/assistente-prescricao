generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("TURSO_DATABASE_URL")
}

model Template {
  id            String         @id @default(cuid())
  name          String
  description   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  items         TemplateItem[]
  prescriptions Prescription[]
}

model TemplateItem {
  id                  String              @id @default(cuid())
  templateId          String
  template            Template            @relation(fields: [templateId], references: [id], onDelete: Cascade)
  position            Int
  description         String
  category            String              // DIETA, HIDRATACAO, MEDICAMENTO, PROTOCOLO, CUIDADO
  isProtocol          Boolean             @default(false)
  protocolDetail      String?
  enabledByDefault    Boolean             @default(true)
  defaultScheduleType String              // ACM, HORARIO, SN, CONDICIONAL
  variants            String              // JSON string with predefined options
  isEditable          Boolean             @default(true)
  createdAt           DateTime            @default(now())
  prescriptionItems   PrescriptionItem[]
}

model CatalogItem {
  id                String              @id @default(cuid())
  name              String
  fullDescription   String
  category          String              // ANTIBIOTICO, ANTICOAGULANTE, ELETROLITO, SONDA, OUTRO
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  prescriptionItems PrescriptionItem[]
}

model Shift {
  id            String         @id @default(cuid())
  shiftDate     DateTime
  notes         String?
  createdAt     DateTime       @default(now())
  prescriptions Prescription[]
}

model Prescription {
  id               String             @id @default(cuid())
  shiftId          String
  shift            Shift              @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  templateId       String
  template         Template           @relation(fields: [templateId], references: [id], onDelete: Restrict)
  patientName      String
  prescriptionDate DateTime           @default(now())
  position         Int
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  items            PrescriptionItem[]
}

model PrescriptionItem {
  id              String        @id @default(cuid())
  prescriptionId  String
  prescription    Prescription  @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  templateItemId  String?
  templateItem    TemplateItem? @relation(fields: [templateItemId], references: [id], onDelete: SetNull)
  catalogItemId   String?
  catalogItem     CatalogItem?  @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)
  position        Int
  description     String
  scheduleType    String
  isEnabled       Boolean       @default(true)
  isManual        Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}
