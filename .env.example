# === Banco de Dados (Turso) ===
# Crie uma conta gratuita em https://turso.tech e um banco de dados.
TURSO_DATABASE_URL="libsql://seu-banco.turso.io"
TURSO_AUTH_TOKEN="seu-token-aqui"

# === Autenticação ===
# Gere o hash da senha com: npx bcryptjs hash "sua-senha"
AUTH_PASSWORD_HASH="$2b$10$hash-bcrypt-da-sua-senha"
# Gere uma chave aleatória com: openssl rand -base64 32
AUTH_SECRET="chave-secreta-aleatoria-para-jwt"

# === Instituição (personalize para seu local) ===
INSTITUTION_NAME="Nome da Instituição de Saúde"
INSTITUTION_SUBTITLE="Unidade de Atendimento"
INSTITUTION_LOGO_PATH="/logos/default-logo.png"
